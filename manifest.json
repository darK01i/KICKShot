{
  "manifest_version": 3,
  "name": "KICKShot",
  "version": "1.0.16",
  "minimum_chrome_version": "121",
  "description": "Compartilhe imagens temporárias e GIFs e visualize mídias no chat da Kick.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/qr-vaquinha-livepix-gg.png",
        "icons/klipy-logo.png",
        "privacy.html"
      ],
      "matches": [
        "https://kick.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://kick.com/*",
    "https://files.catbox.moe/*",
    "https://media.giphy.com/*",
    "https://media1.giphy.com/*",
    "https://i.giphy.com/*",
    "https://media.tenor.com/*",
    "https://c.tenor.com/*",
    "https://media1.tenor.com/*",
    "https://static.klipy.com/*",
    "https://static1.klipy.com/*",
    "https://static2.klipy.com/*",
    "https://i.ibb.co/*",
    "https://kickshot-imgbb-teste.darkartz75.workers.dev/*",
    "https://kickshot-klipy.darkartz75.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "media-codes.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kickshot@darkartz75",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent",
          "searchTerms",
          "websiteActivity",
          "personallyIdentifyingInfo"
        ]
      }
    }
  }
}
