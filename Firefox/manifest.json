{
  "manifest_version": 3,
  "name": "KICKShot",
  "version": "1.0.13",
  "browser_specific_settings": {
    "gecko": {
      "id": "kickshot@darkartz75",
      "data_collection_permissions": {
        "required": [
          "searchTerms",
          "websiteContent",
          "personallyIdentifyingInfo"
        ],
        "optional": []
      }
    }
  },
  "description": "Compartilhamento de imagens e visualização de mídias no chat da Kick",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/qr-vaquinha-livepix-gg.png"
      ],
      "matches": [
        "https://kick.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://catbox.moe/*",
    "https://files.catbox.moe/*",
    "https://media.giphy.com/*",
    "https://media1.giphy.com/*",
    "https://i.giphy.com/*",
    "https://media.tenor.com/*",
    "https://c.tenor.com/*",
    "https://media1.tenor.com/*",
    "https://api.klipy.com/*",
    "https://static.klipy.com/*",
    "https://static1.klipy.com/*",
    "https://static2.klipy.com/*"
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "klipy-config.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "media-codes.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
